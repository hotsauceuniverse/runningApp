<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    >

    <!-- 왼쪽 날짜 박스 -->
    <LinearLayout
        android:layout_width="58dp"
        android:layout_height="92dp"
        android:background="@drawable/bg_history_date_box"
        android:gravity="center"
        android:orientation="vertical"
        >

        <TextView
            android:id="@+id/tv_record_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10월"
            android:textColor="#68756F"
            android:textSize="11sp"
            />

        <TextView
            android:id="@+id/tv_record_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="20"
            android:textColor="#172B25"
            android:textSize="23sp"
            android:textStyle="bold"
            />

        <TextView
            android:id="@+id/tv_record_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="화"
            android:textColor="#68756F"
            android:textSize="11sp"
            />

    </LinearLayout>

    <!-- 오른쪽 기록 카드 -->
    <LinearLayout
        android:id="@+id/layout_record_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_history_record_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="14dp"
        >

        <!-- 기록 제목과 화살표 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            >

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                >

                <TextView
                    android:id="@+id/tv_record_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="러닝 기록"
                    android:textColor="#172B25"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:id="@+id/tv_record_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="2026.10.20"
                    android:textColor="#68756F"
                    android:textSize="10sp"
                    />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#87928C"
                android:textSize="25sp"
                />

        </LinearLayout>

        <!-- 거리, 시간, 평균 페이스 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            >

            <!-- 거리 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.05"
                android:orientation="vertical"
                >

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    >

                    <TextView
                        android:id="@+id/tv_record_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5.24"
                        android:textColor="#287654"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_marginBottom="3dp"
                        android:text="km"
                        android:textColor="#68756F"
                        android:textSize="10sp"
                        />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="거리"
                    android:textColor="#68756F"
                    android:textSize="10sp"
                    />

            </LinearLayout>

            <!-- 시간 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.95"
                android:orientation="vertical"
                >

                <TextView
                    android:id="@+id/tv_record_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="32:18"
                    android:textColor="#172B25"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="시간"
                    android:textColor="#68756F"
                    android:textSize="10sp"
                    />

            </LinearLayout>

            <!-- 평균 페이스 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:orientation="vertical"
                >

                <TextView
                    android:id="@+id/tv_record_pace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6'10&quot;"
                    android:textColor="#172B25"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="평균 페이스"
                    android:textColor="#68756F"
                    android:textSize="10sp"
                    />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
