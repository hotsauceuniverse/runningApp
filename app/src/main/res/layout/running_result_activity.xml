<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    >

    <!-- ========================= -->
    <!-- 스크롤 영역 -->
    <!-- ========================= -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <ImageView
                android:id="@+id/close_btn"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:src="@drawable/close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/result_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintTop_toBottomOf="@id/close_btn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                >

                <TextView
                    android:id="@+id/date_tv"
                    android:layout_width="0dp"
                    android:layout_height="25dp"
                    android:gravity="center_vertical"
                    android:text="오늘 - 오전 8:58"
                    android:textColor="#808080"
                    android:textSize="20sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <LinearLayout
                    android:id="@+id/running_fl"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/date_tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    >

                    <EditText
                        android:id="@+id/day_tv"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="일요일 오전 러닝"
                        android:textColor="@color/black"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:background="@null"
                        android:maxLines="1"
                        android:ellipsize="end"
                        />

                    <ImageView
                        android:id="@+id/edit_iv"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="15dp"
                        android:src="@drawable/edit"
                        />

                </LinearLayout>

                <View
                    android:id="@+id/view"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="#C5C5C5"
                    app:layout_constraintTop_toBottomOf="@id/running_fl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <TextView
                    android:id="@+id/km_tv"
                    android:layout_width="0dp"
                    android:layout_height="70dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:text="42.195"
                    android:textColor="@color/black"
                    android:textSize="55sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/view"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <TextView
                    android:id="@+id/tv_1"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:text="킬로미터"
                    android:textColor="#808080"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/km_tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/statistics_fl"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:layout_marginTop="15dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    >

                    <!-- 평균 페이스 -->
                    <LinearLayout
                        android:id="@+id/pace_layout"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:orientation="vertical"
                        app:layout_constraintWidth_percent="0.333"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        >

                        <TextView
                            android:id="@+id/average_pace_tv"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center_vertical"
                            android:text="99'99&quot;"
                            android:textColor="@color/black"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="평균 페이스"
                            android:textColor="#808080"
                            android:textSize="16sp"
                            />

                    </LinearLayout>

                    <!-- 시간 -->
                    <LinearLayout
                        android:id="@+id/time_layout"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:orientation="vertical"
                        app:layout_constraintWidth_percent="0.333"
                        app:layout_constraintStart_toEndOf="@id/pace_layout"
                        app:layout_constraintTop_toTopOf="parent"
                        >

                        <TextView
                            android:id="@+id/time_tv"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center_vertical"
                            android:text="60:60:60"
                            android:textColor="@color/black"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="시간"
                            android:textColor="#808080"
                            android:textSize="16sp"
                            />

                    </LinearLayout>

                    <!-- 칼로리 -->
                    <LinearLayout
                        android:id="@+id/calorie_layout"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/time_layout"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        >

                        <TextView
                            android:id="@+id/calorie_tv"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center_vertical"
                            android:text="999"
                            android:textColor="@color/black"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="칼로리"
                            android:textColor="#808080"
                            android:textSize="16sp"
                            />

                    </LinearLayout>

                    <!-- 고도 상승 -->
                    <LinearLayout
                        android:id="@+id/distance_layout"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:orientation="vertical"
                        app:layout_constraintWidth_percent="0.333"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        >

                        <TextView
                            android:id="@+id/distance_tv"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center_vertical"
                            android:text="100m"
                            android:textColor="@color/black"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="고도 상승"
                            android:textColor="#808080"
                            android:textSize="16sp"
                            />

                    </LinearLayout>

                    <!-- 평균속도 -->
                    <LinearLayout
                        android:id="@+id/speed_layout"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:orientation="vertical"
                        app:layout_constraintWidth_percent="0.333"
                        app:layout_constraintStart_toEndOf="@id/distance_layout"
                        app:layout_constraintBottom_toBottomOf="parent"
                        >

                        <TextView
                            android:id="@+id/averageSpeed_tv"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center_vertical"
                            android:text="17 km/h"
                            android:textColor="@color/black"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="평균속도"
                            android:textColor="#808080"
                            android:textSize="16sp"
                            />

                    </LinearLayout>

                    <!-- 케이던스 -->
                    <LinearLayout
                        android:id="@+id/cadence_layout"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:orientation="vertical"
                        app:layout_constraintStart_toEndOf="@id/speed_layout"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        >

                        <TextView
                            android:id="@+id/cadence_tv"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center_vertical"
                            android:text="----"
                            android:textColor="@color/black"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="케이던스"
                            android:textColor="#808080"
                            android:textSize="16sp"
                            />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <ImageView
                    android:id="@+id/result_map_image"
                    android:layout_width="0dp"
                    android:layout_height="300dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintTop_toBottomOf="@id/statistics_fl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="25dp"
                    android:background="#EEEEEE"
                    />

                <View
                    android:id="@+id/bottom_space"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    app:layout_constraintTop_toBottomOf="@id/result_map_image"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ========================= -->
    <!-- 화면 하단 고정 저장 버튼 -->
    <!-- ========================= -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_save"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/save_btn"
        android:text="저장"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>