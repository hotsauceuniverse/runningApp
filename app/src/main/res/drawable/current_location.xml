<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 흰색 외곽 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- 파란색 내부 -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">

        <shape android:shape="oval">
            <solid android:color="#4285F4" />
        </shape>

    </item>

</layer-list>